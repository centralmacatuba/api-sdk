{
  "name": "@centralmacatuba/api",
  "version": "0.1.0",
  "description": "SDK em JavaScript e TypeScript para a API pública do projeto independente Central Macatuba.",
  "license": "MIT",
  "author": "Desenvolvedor EE <desenvolvedor.ee@desenvolvedoree.qzz.io> (https://desenvolvedoree.qzz.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centralmacatuba/api-sdk.git"
  },
  "homepage": "https://sdk.centralmacatuba.qzz.io/",
  "bugs": {
    "url": "https://github.com/centralmacatuba/api-sdk/issues"
  },
  "keywords": [
    "central-macatuba",
    "centralmacatuba",
    "macatuba",
    "api",
    "sdk",
    "javascript",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.12.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "generate:types": "openapi-typescript ./openapi/openapi.json -o ./src/generated/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm generate:types && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build",
    "test:integration": "vitest run test/integration.test.ts",
    "test:browser": "node test/browser-consumer.mjs",
    "docs:dev": "pnpm docs:generate && vitepress dev docs",
    "docs:build": "pnpm docs:generate && vitepress build docs",
    "docs:preview": "pnpm docs:generate && vitepress preview docs",
    "release": "changeset publish",
    "docs:generate": "node scripts/generate-docs-reference.mjs",
    "docs:test": "vitest run test/docs.test.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.19.0",
    "openapi-typescript": "^7.10.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "vitepress": "1.6.4"
  }
}
